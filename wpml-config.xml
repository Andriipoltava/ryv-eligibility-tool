<?xml version="1.0" encoding="UTF-8"?>
<!--
  WPML picks this up automatically from the plugin root (no PHP hook
  needed) to pre-register `ryv_forms` and its schema meta for translation,
  instead of leaving a site admin to click through WPML's Custom
  Fields Translation settings UI by hand.

  Real limitation to know before relying on this: `_ryv_form_schema` is
  one JSON blob holding the ENTIRE flat decision graph (see CLAUDE.md's
  "Data model" section) - not a set of discrete translatable strings.
  `action="translate"` only gets a translator a raw JSON/HTML textarea in
  WPML's editor for the whole blob, not the structured per-node UI this
  plugin's own admin/builder SPA provides - editing it there is error
  prone (one bad edit can corrupt the whole graph) and gives none of
  RYV_CPT::save_schema()'s validation. The vetted path for a
  second-language version of a form, already used by this project's own
  source data (see assets/yaml/webform.webform.voting_rights_spanish.yml -
  the original Drupal source itself ships Spanish as an entirely separate
  webform, not a translated copy of the English one) is importing a
  second, independent `ryv_forms` post via RYV_YAML_Parser and embedding
  it on the other-language page. This file exists so WPML doesn't corrupt
  or silently drop the schema meta if a site nonetheless does connect a
  translated form through WPML's own workflow, not to recommend that
  workflow over a separate imported form.
-->
<wpml-config>
	<custom-types>
		<!-- Lets WPML's per-language duplicate/translate workflow apply to
		     ryv_forms at all; post_title/post_excerpt (the widget's
		     optional server-rendered title/description, see
		     widgets/class-ryv-widget.php) translate automatically as core
		     fields once the post type itself is registered here. -->
		<custom-type translate="1">ryv_forms</custom-type>
	</custom-types>
	<custom-fields>
		<!-- The form's entire node graph - see the caveat above. -->
		<custom-field action="translate">_ryv_form_schema</custom-field>
		<!-- Import review metadata (RYV_Import_Page::REVIEW_META_KEY) -
		     admin-only bookkeeping, not visitor-facing content, so it's
		     carried over rather than offered up for translation. -->
		<custom-field action="copy">_ryv_import_warnings</custom-field>
	</custom-fields>
</wpml-config>
