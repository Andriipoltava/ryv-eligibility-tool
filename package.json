{
  "name": "ryv-eligibility-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Build tooling for the RYV Eligibility Tool WordPress plugin (Tailwind CSS for the frontend decision engine, @wordpress/scripts for the admin form builder).",
  "scripts": {
    "build": "tailwindcss -i ./assets/src/input.css -o ./assets/css/app.css --minify",
    "watch": "tailwindcss -i ./assets/src/input.css -o ./assets/css/app.css --watch",
    "admin:build": "wp-scripts build admin/src/index.js --output-path=admin/build",
    "admin:start": "wp-scripts start admin/src/index.js --output-path=admin/build"
  },
  "devDependencies": {
    "@wordpress/scripts": "^34.0.0",
    "tailwindcss": "^3.4.13"
  },
  "dependencies": {
    "@wordpress/components": "^38.0.0",
    "@wordpress/element": "^8.4.0",
    "@wordpress/i18n": "^6.25.0"
  }
}
